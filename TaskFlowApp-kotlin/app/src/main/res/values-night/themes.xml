<?xml version="1.0" encoding="utf-8"?>
<!-- Dark variant: same theme, light status-bar icons over the dark window. -->
<resources>
    <style name="Theme.TaskFlow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/taskflow_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
